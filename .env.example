# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# FutuOpenD 网关地址
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# 数据库
DB_PATH=./data/stockwatch.db

# 推送策略
HOURLY_SUMMARY=true              # 整点是否推摘要
SCAN_INTERVAL_MINUTES=15         # 扫描间隔
ALERT_COOLDOWN_MINUTES=60        # 同一信号冷却时间(避免刷屏)

# 时区
TZ=Asia/Shanghai

# 综合打分 (工作日 06:00 自动跑)
SCORE_OPPORTUNITY_THRESHOLD=70
SCORE_RISK_THRESHOLD=30
SCORING_ALERT_COOLDOWN_HOURS=24

# 集中度 / 汇率 (P3-1, 暂用常量)
FX_USD_CNY=7.2
FX_HKD_CNY=0.93
HHI_HIGH_THRESHOLD=0.25
HHI_MID_THRESHOLD=0.15
TOP1_WARN_THRESHOLD=0.5

# 数据保留 (每周日 03:00 清理)
RETENTION_SIGNALS_DAYS=90
RETENTION_PRICE_SNAPSHOTS_DAYS=90
RETENTION_NEWS_DAYS=180
RETENTION_SCORES_DAYS=180
RETENTION_VACUUM=true

# 新闻白名单 & 情绪缓存 (P4-1)
NEWS_WHITELIST_ENABLED=true
NEWS_WHITELIST_EXTRA=
SENTIMENT_CACHE_ENABLED=true
