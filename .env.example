# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# FutuOpenD 网关地址
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# 数据库
DB_PATH=./data/stockwatch.db

# 推送策略
HOURLY_SUMMARY=true              # 整点是否推摘要
SCAN_INTERVAL_MINUTES=15         # 扫描间隔
ALERT_COOLDOWN_MINUTES=60        # 同一信号冷却时间(避免刷屏)

# 时区
TZ=Asia/Shanghai

# 综合打分 (工作日 06:00 自动跑)
SCORE_OPPORTUNITY_THRESHOLD=70
SCORE_RISK_THRESHOLD=30
SCORING_ALERT_COOLDOWN_HOURS=24
